# ============================================================
# IUGA Backend
# Copy this to env/.env.dev (gitignored) and fill in real values.
# NEVER put real passwords in this file - it may be committed.
# ============================================================

# --- App / database (single DB_URI var, per models.js) ---
DEPLOY_ENV=development
DB_URI=mongodb://127.0.0.1:27017/iuga_dev
PORT=7777

SMTP_HOST=smtp.uw.edu
SMTP_PORT=587
SMTP_USER=your-rso-netid
UW_NETID_PASSWORD=
SMTP_FROM=IUGA <your-rso-netid@uw.edu>

# --- Contact form delivery (SendGrid) ---
# CONTACT_EMAIL_FROM must be a verified SendGrid sender identity.
SENDGRID_API_KEY=
CONTACT_EMAIL_FROM=IUGA <your-verified-sender@example.com>
CONTACT_EMAIL_TO=iuga@uw.edu

DISCORD_BOT_TOKEN=FAKE.MzI0NTY3ODkwMTIzNDU2Nzg.GfakeAbCdEfGhIjKlMnOp
